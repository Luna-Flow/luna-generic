msgid "core tutorial"
msgstr "core 教程"

#: manual/tutorial/core.md:3
msgid "Quick start for library authors"
msgstr "给库作者的快速入门"

#: manual/tutorial/core.md:5
msgid "I want to"
msgstr "我想要"

#: manual/tutorial/core.md:5
msgid "Use"
msgstr "使用"

