// Tests for the BigInt -> Double / Float conversions behind `from_integer`,
// `from_natural` and `lift_to`.
//
// The expected bit patterns at the end of this file were generated with
// Python 3.13: `float(int)` for Double (correctly rounded, ties to even; an
// OverflowError means ±inf), and exact integer round-to-nearest-even at 24
// bits for Float (no numpy, so no rounding through Double first). The random
// cases use `random.Random(20261009)` and cover random values, long runs of
// ones, exact ties with or without a far sticky bit, and sparse values.

///|
/// Parses an optionally negated lowercase hex string with shifts and `|`
/// only, so these tests do not depend on core's string parser.
fn big_of_hex(s : String) -> BigInt {
  let negative = s.has_prefix("-")
  let mut acc = BigInt::from_int(0)
  for i = (if negative { 1 } else { 0 }); i < s.length(); i = i + 1 {
    let c = s.code_unit_at(i).to_int()
    let d = if c >= '0'.to_int() && c <= '9'.to_int() {
      c - '0'.to_int()
    } else if c >= 'a'.to_int() && c <= 'f'.to_int() {
      c - 'a'.to_int() + 10
    } else {
      abort("big_of_hex: invalid digit")
    }
    acc = (acc << 4) | BigInt::from_int(d)
  }
  if negative {
    -acc
  } else {
    acc
  }
}

///|
fn to_double(x : BigInt) -> Double {
  @luna-generic.FromInteger::from_integer(x)
}

///|
fn to_float(x : BigInt) -> Float {
  @luna-generic.FromInteger::from_integer(x)
}

///|
fn pow2(k : Int) -> BigInt {
  BigInt::from_int(1) << k
}

///|
fn check_double_table(table : Array[(String, UInt64)]) -> Unit raise {
  for row in table {
    let (hex, bits) = row
    let got = to_double(big_of_hex(hex)).reinterpret_as_uint64()
    if got != bits {
      fail("Double of 0x\{hex}: got \{got}, want \{bits}")
    }
  }
}

///|
fn check_float_table(table : Array[(String, UInt)]) -> Unit raise {
  for row in table {
    let (hex, bits) = row
    let got = to_float(big_of_hex(hex)).reinterpret_as_uint()
    if got != bits {
      fail("Float of 0x\{hex}: got \{got}, want \{bits}")
    }
  }
}

///|
test "big_of_hex" {
  inspect(big_of_hex("0"), content="0")
  inspect(big_of_hex("ff"), content="255")
  inspect(big_of_hex("-10000000000000001"), content="-18446744073709551617")
}

///|
test "Double: exact below 2^53 and ties to even above" {
  // Every expected value below is an exactly representable Double, so the
  // literals are exact; values are compared, not printed, because `Show`
  // prints the shortest round-trip digits.
  let two53 = pow2(53)
  let two54 = pow2(54)
  let n = BigInt::from_int
  assert_eq(to_double(two53 - n(1)), 9007199254740991.0)
  assert_eq(to_double(two53), 9007199254740992.0)
  // 2^53 + 1 is a tie between 2^53 and 2^53 + 2: the even one is 2^53.
  assert_eq(to_double(two53 + n(1)), 9007199254740992.0)
  assert_eq(to_double(two53 + n(2)), 9007199254740994.0)
  // 2^53 + 3 is a tie between 2^53 + 2 and 2^53 + 4: the even one is + 4.
  assert_eq(to_double(two53 + n(3)), 9007199254740996.0)
  // 2^54 + 2 is a tie between 2^54 and 2^54 + 4: the even one is 2^54.
  assert_eq(to_double(two54 + n(2)), 18014398509481984.0)
  // Just off the tie, the nearest neighbour wins.
  assert_eq(to_double(two54 + n(1)), 18014398509481984.0)
  assert_eq(to_double(two54 + n(3)), 18014398509481988.0)
  // 2^54 + 6 is a tie between 2^54 + 4 and 2^54 + 8: the even one is + 8.
  assert_eq(to_double(two54 + n(6)), 18014398509481992.0)
  // Carry out of the significand: 2^54 - 1 rounds up to 2^54.
  assert_eq(to_double(two54 - n(1)), 18014398509481984.0)
  assert_eq(to_double(-(two53 + n(1))), -9007199254740992.0)
  assert_eq(to_double(-(two53 + n(3))), -9007199254740996.0)
}

///|
test "Double: overflow threshold 2^1024 - 2^970" {
  let threshold = pow2(1024) - pow2(970)
  let one = BigInt::from_int(1)
  let max = to_double(pow2(1024) - pow2(971))
  inspect(max.reinterpret_as_uint64(), content="9218868437227405311")
  assert_eq(to_double(threshold - one), max)
  assert_eq(to_double(threshold), @double.infinity)
  assert_eq(to_double(-(threshold - one)), -max)
  assert_eq(to_double(-threshold), @double.neg_infinity)
  assert_eq(to_double(pow2(1024)), @double.infinity)
}

///|
test "Float: overflow threshold 2^128 - 2^103" {
  let threshold = pow2(128) - pow2(103)
  let one = BigInt::from_int(1)
  let max = to_float(pow2(128) - pow2(104))
  inspect(max.reinterpret_as_uint(), content="2139095039")
  assert_eq(to_float(threshold - one), max)
  assert_eq(to_float(threshold), @float.infinity)
  assert_eq(to_float(-(threshold - one)), -max)
  assert_eq(to_float(-threshold), @float.neg_infinity)
}

///|
test "Float rounds once, not through Double" {
  // 2^53 + 2^29 + 1 rounds to the Double 2^53 + 2^29, an exact Float tie
  // that would then round to 2^53. Rounded once, it is 2^53 + 2^30.
  let x = pow2(53) + pow2(29) + BigInt::from_int(1)
  let f = to_float(x)
  assert_eq(f.reinterpret_as_uint(), 0x5A000001U)
  // The old path, Float::from_double on the Double result, rounds twice.
  assert_eq(Float::from_double(to_double(x)).reinterpret_as_uint(), 0x5A000000U)
}

///|
test "huge values give infinities" {
  let ten400 = BigInt::from_int(10).pow(BigInt::from_int(400))
  let two5000 = pow2(5000)
  assert_eq(to_double(ten400), @double.infinity)
  assert_eq(to_double(-ten400), @double.neg_infinity)
  assert_eq(to_double(two5000), @double.infinity)
  assert_eq(to_double(-two5000), @double.neg_infinity)
  assert_eq(to_float(ten400), @float.infinity)
  assert_eq(to_float(-ten400), @float.neg_infinity)
  assert_eq(to_float(two5000), @float.infinity)
  assert_eq(to_float(-two5000), @float.neg_infinity)
}

///|
test "zero is +0" {
  let z = BigInt::from_int(0)
  assert_eq(to_double(z).reinterpret_as_uint64(), 0UL)
  assert_eq(to_double(-z).reinterpret_as_uint64(), 0UL)
  assert_eq(to_float(z).reinterpret_as_uint(), 0U)
  assert_eq(to_float(-z).reinterpret_as_uint(), 0U)
}

///|
#warnings("-deprecated")
test "conversions into Double and Float no longer abort" {
  let big = pow2(1024)
  let d : Double = @luna-generic.lift_to(big)
  assert_eq(d, @double.infinity)
  let d : Double = @luna-generic.lift_to(-big)
  assert_eq(d, @double.neg_infinity)
  let f : Float = @luna-generic.lift_to(big)
  assert_eq(f, @float.infinity)
  let d : Double = @luna-generic.FromNat::from_natural(big)
  assert_eq(d, @double.infinity)
  let f : Float = @luna-generic.FromNat::from_natural(pow2(128))
  assert_eq(f, @float.infinity)
  let h : @luna-generic.Hom[@luna-generic.SemiringSig, BigInt, Double] = @luna-generic.Hom::from_integer()
  assert_eq(h.apply(-big), @double.neg_infinity)
  let d : Double = @luna-generic.IntegralHomomorphism::from_integral(big)
  assert_eq(d, @double.infinity)
  let f : Float = @luna-generic.IntegralHomomorphism::from_integral(-big)
  assert_eq(f, @float.neg_infinity)
}

///|
test "Double: boundary vectors" {
  check_double_table(double_boundary)
}

///|
test "Double: random differential vectors" {
  check_double_table(double_random)
}

///|
test "Float: boundary vectors" {
  check_float_table(float_boundary)
}

///|
test "Float: random differential vectors" {
  check_float_table(float_random)
}

